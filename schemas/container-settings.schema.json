{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "./settings.schema.json",
  "title": "Container Settings",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "upstream_env_url",
    "ports",
    "env",
    "volumes"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "ports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "port",
          "protocol",
          "required"
        ],
        "properties": {
          "port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "protocol": {
            "type": "string",
            "enum": [
              "tcp",
              "udp",
              "sctp"
            ]
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "env": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "default",
          "required"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
          },
          "default": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "volumes": {
      "type": "array",
      "minItems": 1,
      "contains": {
        "type": "object",
        "required": [
          "path"
        ],
        "properties": {
          "path": {
            "const": "/config"
          }
        }
      },
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "required"
        ],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    },
    "upstream_env_url": {
      "type": "string",
      "description": "URL to upstream environment variable documentation"
    },
    "dependencies": {
      "type": "array",
      "description": "Other containers in this repository that this container depends on at runtime",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "opt_dependencies": {
      "type": "array",
      "description": "Other containers in this repository that this container can optionally use at runtime",
      "items": {
        "$ref": "#/$defs/dependency"
      }
    },
    "compose": {
      "type": "object",
      "description": "Optional docker-compose service-spec fragment merged on top of the service generated for this app. Uses compose-spec merge semantics; any field accepted under services.<name> in a docker-compose file is allowed here.",
      "additionalProperties": true
    },
    "resources": {
      "type": "object",
      "description": "Optional CPU/memory limits and reservations applied to the generated service via the compose deploy.resources block. Any field omitted falls back to the generator's default (currently cpus: 4, memory: 4G for limits; no reservations).",
      "additionalProperties": false,
      "properties": {
        "limits": {
          "$ref": "#/$defs/resourceQuota"
        },
        "reservations": {
          "$ref": "#/$defs/resourceQuota"
        }
      }
    }
  },
  "$defs": {
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of another container in this repository (its directory under apps/). Used to look up the dependency's settings.yaml and as the docker-compose service name.",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "compose": {
          "type": "object",
          "description": "Optional docker-compose service-spec fragment. Merged on top of the service generated from the dependency's own settings.yaml using compose-spec merge semantics. The 'image' field, if set, overrides the generated ghcr.io/trueforge-org/<name>:<version> reference.",
          "additionalProperties": true
        }
      }
    },
    "resourceQuota": {
      "type": "object",
      "description": "A docker-compose deploy.resources quota (limits or reservations).",
      "additionalProperties": true,
      "properties": {
        "cpus": {
          "description": "Number of CPUs (e.g. 1.5 or \"2\").",
          "type": ["number", "string"]
        },
        "memory": {
          "description": "Memory amount in compose-spec syntax, e.g. 512M, 4G or a raw byte count.",
          "type": ["string", "integer"]
        },
        "pids": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}